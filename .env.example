# Client Vite: queste variabili sono pubbliche nel bundle del browser.
VITE_ANALYSIS_PATH=/api/analyze
VITE_ANALYSIS_TEXT_PATH=/api/analyze-text
VITE_ANALYSIS_PREMIUM=true

# Boundary server-side: non inserire qui chiavi reali.
APP_ACCESS_KEY=replace-with-a-private-access-key
ANALYSIS_ENDPOINT=https://analysis.example.com/analizza
# Opzionale: se assente, il testo usa ANALYSIS_ENDPOINT.
ANALYSIS_TEXT_ENDPOINT=https://analysis.example.com/analizza
ANALYSIS_PREMIUM=true
